# History files
.Rhistory
.Rapp.history

# Session Data files
.RData
.RDataTmp

# User-specific files
.Ruserdata

# Example code in package build process
*-Ex.R

# Output files from R CMD build
/*.tar.gz

# Output files from R CMD check
/*.Rcheck/

# RStudio files
.Rproj.user/

# produced vignettes
vignettes/*.html
vignettes/*.pdf
README.html

# OAuth2 token, see https://github.com/hadley/httr/releases/tag/v0.3
.httr-oauth

# knitr and R markdown default cache directories
*_cache/
/cache/

# Temporary files created by R markdown
*.utf8.md
*.knit.md

# R Environment Variables
.Renviron
.env

# pkgdown site
docs/

# translation temp files
po/*~

# RStudio Connect folder
rsconnect/

# macOS
.DS_Store

# ---- Outputs generated by the scripts in 02_Scripts/ ----
# The folders are kept (via .gitkeep) because the scripts write into them,
# but their contents are recreated by running the scripts.
03_Analysis_files/*
!03_Analysis_files/.gitkeep
04_Figures/*
!04_Figures/.gitkeep
04_Tables/*
!04_Tables/.gitkeep
05_supplementary_figures/*
!05_supplementary_figures/.gitkeep

# Knitted R Markdown reports
02_Scripts/*.html
02_Scripts/*_files/
